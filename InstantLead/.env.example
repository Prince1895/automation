# Copy to .env, then fill the keys used by your tools and adjust the caps.
# Never commit .env or print its values.

# ---------------------------------------------------------------------------
# Runtime
# ---------------------------------------------------------------------------
DRY_RUN=0
BRAND_CONFIG=config/brand.yaml
DB_PATH=.tmp/instantlead.db
ARCHIVE_DIR=.tmp/archive
OUTBOX_DIR=.tmp/outbox
LOG_DIR=logs
PUBLIC_BASE_URL=http://localhost:8080
SERVICE_HOST=0.0.0.0
SERVICE_PORT=8080
WORKER_ENABLED=1
SCHEDULER_ENABLED=1
WORKER_POLL_SECONDS=3
MAX_EVENT_ATTEMPTS=6
LOG_LEVEL=INFO

# ---------------------------------------------------------------------------
# LLM (OpenRouter). Leave the key empty to run rules-only.
# Free models are rate-limited; the agent falls back to rules automatically.
# ---------------------------------------------------------------------------
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
LLM_ENABLED=1
LLM_MAX_TOKENS=500
LLM_TIMEOUT_SECONDS=20

# ---------------------------------------------------------------------------
# Google OAuth (Desktop client). Token is written to GOOGLE_TOKEN_PATH.
# Scopes: gmail.send, gmail.readonly, spreadsheets, calendar, drive,
# forms.responses.readonly
# ---------------------------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8765/oauth2callback
GOOGLE_TOKEN_PATH=.tmp/google_token.json

# Google resources
SHEET_ID=
SHEET_TAB=Leads
QUARANTINE_TAB=Quarantine
DIGEST_TAB=Digest
DRIVE_FOLDER_ID=
CALENDAR_ID=primary
SALES_EMAILS=
SENDER_EMAIL=
SENDER_NAME=

# ---------------------------------------------------------------------------
# Lead sources
# ---------------------------------------------------------------------------
# Meta app shared by WhatsApp Cloud API and Instagram Messaging
META_APP_ID=
META_APP_SECRET=
META_VERIFY_TOKEN=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
INSTAGRAM_ACCOUNT_ID=

# Website form webhook shared secret (sent as X-Webhook-Token)
FORM_WEBHOOK_SECRET=

# Gmail inbox polling (recommended) or IMAP fallback
EMAIL_SOURCE=gmail
GMAIL_QUERY=subject:(enquiry OR inquiry OR "get in touch" OR "property") newer_than:2d -from:me
GMAIL_POLL_ENABLED=1
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_USER=
IMAP_APP_PASSWORD=
IMAP_FOLDER=INBOX
IMAP_SEARCH=(UNSEEN)

# Google Forms polling
GOOGLE_FORM_ID=
FORMS_POLL_ENABLED=0

# ---------------------------------------------------------------------------
# Routing, scheduling and SLA (default Asia/Kolkata; override BUSINESS_TZ)
# ---------------------------------------------------------------------------
BUSINESS_TZ=Asia/Kolkata
BUSINESS_DAYS=0,1,2,3,4,5
BUSINESS_START=10:00
BUSINESS_END=19:00
MEETING_MINUTES=30
SLOT_BUFFER_MINUTES=15
BOOKING_HORIZON_HOURS=48
DIGEST_TIME=19:30
DIGEST_ENABLED=1
HOT_SLA_MINUTES=15
WARM_SLA_MINUTES=60
SLA_ENABLED=1
COLD_EMAIL_ENABLED=0
MESSAGE_EXCERPT_CHARS=220
RETENTION_DAYS=365

# Poll intervals (seconds)
FORM_POLL_SECONDS=120
EMAIL_POLL_SECONDS=120
STATUS_SYNC_SECONDS=300
SLA_CHECK_SECONDS=300

# ---------------------------------------------------------------------------
# Hard budget caps in USD, enforced by paid-API tools
# ---------------------------------------------------------------------------
MAX_COST_PER_RUN=1.00
MAX_COST_PER_DAY=10.00
MAX_COST_PER_MONTH=100.00

# ---------------------------------------------------------------------------
# First reply (approval-mode draft emails)
# ---------------------------------------------------------------------------
FIRST_REPLY_MODE=approval
FIRST_REPLY_SLA_MINUTES=5

# ---------------------------------------------------------------------------
# Backups (SQLite online backups)
# ---------------------------------------------------------------------------
BACKUP_ENABLED=1
BACKUP_DIR=.tmp/backups
BACKUP_INTERVAL_HOURS=24
BACKUP_RETENTION=14

# ---------------------------------------------------------------------------
# Alerts (healthz + dead-letter)
# ---------------------------------------------------------------------------
ALERT_CHECK_ENABLED=1
ALERT_CHECK_SECONDS=60
HEALTHZ_URL=http://localhost:8080/healthz
ALERT_WEBHOOK_URL=
ALERT_EMAILS=
DEAD_LETTER_ALERT_THRESHOLD=1
ALERT_COOLDOWN_MINUTES=60

# ---------------------------------------------------------------------------
# Locale overrides (optional; defaults come from config/brand.yaml locale)
# ---------------------------------------------------------------------------
CURRENCY=INR
